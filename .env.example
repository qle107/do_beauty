# Copiez ce fichier vers .env.local et remplissez les valeurs.
# Sur Hostinger : ajoutez ces variables dans le panneau (ne PAS uploader .env.local).

# ─── NextAuth ────────────────────────────────────────────────────────────
# Générer un secret : openssl rand -base64 32
# En production, mettez l'URL HTTPS de votre domaine (ex. https://vynails.fr)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
AUTH_SECRET=

# ─── Cloudflare Turnstile (CAPTCHA) - REQUIS EN PRODUCTION ───────────────
# L'app REFUSE de démarrer en prod sans TURNSTILE_SECRET_KEY (voir instrumentation.ts).
# Créer les clés : https://dash.cloudflare.com → Turnstile → Add site (votre domaine)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Google OAuth (login admin) ──────────────────────────────────────────
# Créer sur : https://console.cloud.google.com → APIs & Services → Credentials
# URI de redirection : https://VOTRE-DOMAINE/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Identité admin ───────────────────────────────────────────────────────
# L'adresse Gmail qui obtient l'accès admin.
ADMIN_EMAIL=
# Destinataire supplémentaire des alertes de nouvelle réservation (optionnel).
BOOKING_NOTIFY_EMAIL=

# ─── Google Calendar A (service account) — website bookings ──────────────
# IMPORTANT : la valeur doit tenir sur UNE SEULE LIGNE (JSON complet échappé)
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_KEY=

# ─── Planity (lecture des disponibilités publiques — sans jeton) ─────────
PLANITY_BUSINESS_ID=
# Optionnel : hôte de la base Firebase publique (valeur par défaut connue si vide)
# PLANITY_AVAIL_DB_HOST=

# ─── Base de données MySQL (services / liste noire / appareils) ──────────
# Requis. Les prestations, la liste noire et le suivi des appareils sont stockés
# en base (les tables sont créées automatiquement au premier démarrage, et le
# catalogue est initialisé depuis data/services.json s'il est vide).
# Renseignez SOIT les variables MYSQL_* (fournies par le panneau Hostinger),
# SOIT une seule DATABASE_URL. Sur Hostinger, activez "Remote MySQL" et ajoutez
# l'IP de l'app si la base est sur un autre hôte.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
# Alternative : DATABASE_URL=mysql://user:password@host:3306/database

# ─── WhatsApp (CallMeBot - gratuit) ─────────────────────────────────────
# Votre numéro sans le + (ex. 33612345678 pour un 06 français)
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# ─── Email admin (Nodemailer) ─────────────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@vynails.fr
SMTP_PASS=
SMTP_FROM=VyNails93 <contact@vynails.fr>
MAIL_FROM=VyNails93 <contact@vynails.fr>

# ─── Informations publiques de l'entreprise ──────────────────────────────
NEXT_PUBLIC_BUSINESS_NAME=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_GOOGLE_MAPS_EMBED=
